# Ignore everything
*

# Except code/, examples/, doc/, paper/, vignettes/, and .claude/
!code/
!code/**
!examples/
!examples/**
!doc/
!doc/**
!paper/
!paper/**
!vignettes/
!vignettes/**
!.claude/
!.claude/**

# And this .gitignore itself
!.gitignore

# Common junk
.DS_Store
.Rhistory
