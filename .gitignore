# Ignore everything by default
*

# Top-level files to track
!.gitignore
!README.md
!LICENSE
!LICENSE.md
!DESCRIPTION
!NAMESPACE
!NEWS.md
!CITATION.cff
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md

# Source directories to track
!code/
!code/**
!R/
!R/**
!man/
!man/**
!src/
!src/**
!tests/
!tests/**
!examples/
!examples/**
!doc/
!doc/**
!paper/
!paper/**
!vignettes/
!vignettes/**

# Bundled pilot data (small, derived, used by examples and vignettes)
!data/
!data/*pilot.rds
!data/estimate_pilot_params.R
!data/README.md

# Selected publication figures
!output/
!output/main_figures/
!output/main_figures/Fig*.pdf
!output/main_figures/SuppFig*.pdf

# CI workflows
!.github/
!.github/**

# Hard exclusions (override the allow rules above)
# Compiled C/C++ build artefacts (override !src/** above)
src/*.o
src/*.so
src/*.dll
**/*.o
**/*.so

# Third-party reference PDFs (copyright; keep locally, do not redistribute)
paper/PowerSim/reference/*.pdf

# Raw counts and metadata that we cannot redistribute
data/*.RData
data/*.csv
data/*.csv.gz
data/*.xlsx
data/archive_*
data/ACC_RNA_filtered_normalized.csv
data/CAMO_PRC_hmb.RData
data/mouse_*
data/MD5_*
data/TOD.xlsx
data/GSE160521_*

# Large intermediate output that should not enter the repo
output/active_vs_passive/
output/bootstrap_sc/
output/sensitivity/
output/single_cohort/
output/differential/
output/supplementary/
output/archive_*/
output/main_figures/archive_*/

# Editor / OS / build junk
**/.DS_Store
**/.Rhistory
**/Rplots.pdf
**/.Rproj.user/
**/.codex/
.Rproj.user/

# LaTeX build artefacts
**/*.aux
**/*.bbl
**/*.blg
**/*.fdb_latexmk
**/*.fls
**/*.log
**/*.out
**/*.synctex.gz
**/*.toc

# Old R scratch
**/.Rapp.history

# Reproducibility bundle: small derived inputs so the figures regenerate
# without the access-controlled raw data (these override the exclusions above)
!data/gse160521_nac_ctrl_pilot.rds
!data/gse160521_caudate_ctrl_pilot.rds
!data/gse160521_putamen_ctrl_pilot.rds
!data/gtex_adr_vs_liv_pilot_paired.rds
!output/two_harmonic/
!output/two_harmonic/results/
!output/two_harmonic/results/tissue_Liver_fits.rds
!output/two_harmonic/results/tissue_Liver_venn.rds
!output/two_harmonic/results/tissue_Liver_kegg.rds
!output/two_harmonic/results/pilot_2h_GTExLiver_topK300.rds
!output/two_harmonic/results/fig6_v9_data.rds

# Local AI tool state (not committed)
.codex/
paper/PowerSim/SCP.tex

# Workstream manifest deltas (merged into manifest.csv; not for repo)
inst/extdata/pilots/manifest.[A-Z].csv
inst/extdata/pilots/ingestion.log*
inst/extdata/pilots/cache_geo/

# Dropped from public repo (kept locally)
code/
doc/
tests/
paper/
paper2/
submission/
base/
slide/
data/
data-raw/
output/
SCP.Rcheck/
examples/exploratory/
examples/figures/
examples/panelC160/
examples/publication/archive/
