# Ignore everything
*

# Except code/, data/, examples/, doc/, paper/, vignettes/, tests/
!code/
!code/**
!data/
!data/**
!examples/
!examples/**
!doc/
!doc/**
!paper/
!paper/**
!vignettes/
!vignettes/**
!tests/
!tests/**

# And this .gitignore itself
!.gitignore

# Root-level documentation
!README.md
!CLAUDE.md

# Common junk
.DS_Store
.Rhistory
**/.DS_Store
**/.Rhistory
