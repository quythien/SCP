# Ignore everything
*

# Except code/, examples/, doc/, paper/, vignettes/
!code/
!code/**
!examples/
!examples/**
!doc/
!doc/**
!paper/
!paper/**
!vignettes/
!vignettes/**

# And this .gitignore itself
!.gitignore

# Root-level documentation
!README.md
!CLAUDE.md

# Common junk
.DS_Store
.Rhistory
**/.DS_Store
**/.Rhistory
